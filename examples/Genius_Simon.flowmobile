          "text": "1",
          "x": 75,
          "y": 145,
          "width": "110px",
          "height": "110px",
          "bg": "#ef4444",
          "color": "#fff",
          "events": {
            "click": "if(!window.ffSimon?.accept)return;const n=0,g=window.ffSimon;ffSimonFlash(n);if(n!==g.seq[g.pos]){g.accept=false;document.getElementById('simonStatus').textContent='Errou! Nível alcançado: '+g.seq.length;return}g.pos++;if(g.pos===g.seq.length){g.accept=false;document.getElementById('simonStatus').textContent='Certo!';setTimeout(ffSimonNext,650)}"
          }
        },
