          "height": "48px",
          "bg": "transparent",
          "color": "#222222",
          "events": {}
        },
        {
          "id": "fde6dd9e-9322-4c84-b8a8-aad6124cae09",
          "kind": "button",
          "name": "pomoFocus",
          "text": "Foco 25",
          "x": 20,
          "y": 132,
          "width": "113px",
          "height": "40px",
          "bg": "#2563eb",
          "color": "#ffffff",
          "events": {
            "click": "var $=function(i){return document.getElementById(i)};if(!window.ffPomo){var M=window.ffPomo={modes:{'Foco':25,'Pausa':5,'Pausa longa':15},mode:'Foco',left:25*60,total:25*60,timer:null,done:0};M.fmt=function(s){var m=Math.floor(s/60),x=s%60;return(m<10?'0':'')+m+':'+(x<10?'0':'')+x};M.bar=function(p){var el=$('pomoBar');el=el.classList.contains('ff-progress')?el:(el.querySelector('.ff-progress')||el);var i=el.querySelector('i');if(i)i.style.setProperty('width',p+'%');el.setAttribute('aria-valuenow',p);var s=el.querySelector('span');if(s)s.textContent=Math.round(p)+'%'};M.draw=function(){var tm=$('pomoTime');tm.textContent=M.fmt(M.left);tm.style.cssText+=';font-size:72px;font-weight:700;line-height:1;text-align:center';$('pomoMode').textContent=M.mode+(M.timer?' — em andamento':' — pausado');$('pomoSessions').textContent='Sessões de foco concluídas: '+M.done;$('pomoStart').textContent=M.timer?'Pausar':(M.left<M.total?'Continuar':'Iniciar');M.bar((M.total-M.left)/M.total*100);document.title=M.fmt(M.left)+' · '+M.mode};M.stop=function(){clearInterval(M.timer);M.timer=null};M.set=function(m){M.stop();M.mode=m;M.total=M.left=M.modes[m]*60;M.draw()};M.tick=function(){M.left--;if(M.left<=0){M.left=0;M.stop();if(M.mode==='Foco')M.done++;M.draw();$('pomoMode').textContent=M.mode+' — concluído!';try{if(navigator.vibrate)navigator.vibrate(200)}catch(e){}return}M.draw()};M.toggle=function(){if(M.timer){M.stop();M.draw();return}if(M.left<=0)M.left=M.total;M.timer=setInterval(M.tick,1000);M.draw()};M.reset=function(){M.stop();M.left=M.total;M.draw()};M.draw()}window.ffPomo.set('Foco');"
          }
        },
        {
          "id": "d3b08093-3831-485d-a669-b34e5a44d3d3",
