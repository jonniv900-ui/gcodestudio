          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "const a = Number(num1.value), b = Number(num2.value);\nlet r;\nswitch(op1.value){case \"Subtrair\":r=a-b;break;case \"Multiplicar\":r=a*b;break;case \"Dividir\":r=b!==0?a/b:\"Erro\";break;default:r=a+b;}\nresult1.textContent = \"Resultado: \" + r;"
          }
        }
      ]
