          "y": 420,
          "width": "220px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "const v = Math.floor(Math.random()*101);\nrange1.value = v;\ncpuCard.textContent = 'CPU: ' + v + '%';\nramCard.textContent = 'RAM: ' + Math.floor(Math.random()*101) + '%';\nwindow.ffCpuHistory = (window.ffCpuHistory || [20, 35, 30, 45, 40, 55, 50]).concat(Number(v)).slice(-12);\nsparkline1.dataset.values = window.ffCpuHistory.join(',');"
          }
        }
      ]
    }
