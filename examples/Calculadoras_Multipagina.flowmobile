          "x": 20,
          "y": 298,
          "width": "151px",
          "height": "44px",
          "bg": "#2563eb",
          "color": "#ffffff",
          "events": {
            "click": "var c=Number(invCap.value.replace(',','.')),m=Number(invMes.value.replace(',','.')),r=Number(invTaxa.value.replace(',','.'))/100,n=Math.floor(Number(invMeses.value));if(!(c>=0)||!(n>0)||!(r>=0)||invCap.value===''||invTaxa.value===''){invResult.textContent='Preencha capital, taxa e meses';invGain.textContent='';return}m=m||0;var s=c;for(var i=0;i<n;i++){s=s*(1+r)+m}var put=c+m*n,f=function(x){return 'R$ '+x.toFixed(2).replace('.',',')};invResult.textContent='Montante: '+f(s);invGain.textContent='Investido '+f(put)+' · Juros '+f(s-put);"
          }
        },
