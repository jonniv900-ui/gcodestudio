          "y": 242,
          "width": "151px",
          "height": "44px",
          "bg": "#2563eb",
          "color": "#ffffff",
          "events": {
            "click": "var p=Number(imcPeso.value.replace(',','.')),a=Number(imcAltura.value.replace(',','.'));if(a>3)a=a/100;if(!(p>0)||!(a>0)){imcResult.textContent='Informe peso (kg) e altura (m)';imcClass.textContent='';return}var v=p/(a*a),c=v<18.5?'Abaixo do peso':v<25?'Peso normal':v<30?'Sobrepeso':v<35?'Obesidade grau I':v<40?'Obesidade grau II':'Obesidade grau III';imcResult.textContent='IMC: '+v.toFixed(1).replace('.',',');imcClass.textContent=c;"
          }
