          "width": "151px",
          "height": "44px",
          "bg": "#2563eb",
          "color": "#ffffff",
          "events": {
            "click": "var b=Number(tipConta.value.replace(',','.')),pct=Number(tipPct.value),n=Math.max(1,Math.floor(Number(tipPessoas.value)||1));if(!(b>0)){tipResult.textContent='Informe o valor da conta';tipPerson.textContent='';return}var tip=b*pct/100,tot=b+tip,f=function(x){return 'R$ '+x.toFixed(2).replace('.',',')};tipResult.textContent='Total: '+f(tot)+' (gorjeta '+f(tip)+')';tipPerson.textContent='Por pessoa ('+n+'): '+f(tot/n);"
          }
