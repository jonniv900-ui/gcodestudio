          "id": "b43e96b8-93dc-489c-bed8-a89b47403477",
          "kind": "file",
          "name": "fileUpload1",
          "text": "Escolher imagem",
          "x": 32,
          "y": 100,
          "width": "280px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "change": "const arquivo = event.target.files[0];\nif (!arquivo) return;\n\nif (!arquivo.type.startsWith(\"image/\")) {\n    alert(\"Selecione um arquivo de imagem.\");\n    event.target.value = \"\";\n    return;\n}\n\n// O PictureBox é um <img> real no HTML exportado/Preview.\nconst urlImagem = URL.createObjectURL(arquivo);\npicturebox1.src = urlImagem;\npicturebox1.alt = arquivo.name;"
          }
        },
        {
          "id": "29262bb2-c940-4161-94e7-316909cf0d6f",
