      "id": "12c5aa75-dc81-48e0-9bf6-701936a8472c",
      "name": "Principal",
      "items": [
        {
          "id": "9f18d789-cf92-48f6-918d-7cfde9823959",
          "kind": "heading",
          "name": "h1",
          "text": "Configurações do App",
          "x": 24,
          "y": 20,
          "width": "340px",
          "height": "52px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "// h1\n"
          }
        },
        {
          "id": "eaea06e2-2fcd-46d2-8bbb-d8bd92b5a0f7",
          "kind": "switch",
          "name": "dark1",
          "text": "Modo escuro",
          "x": 24,
          "y": 95,
          "width": "180px",
          "height": "40px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "change": "document.body.style.background = event.target.checked ? '#111827' : '#ffffff';"
          }
        },
        {
          "id": "cae41fcd-02f3-467a-be15-09ebb118cef0",
          "kind": "range",
          "name": "volume1",
          "text": "",
          "x": 24,
          "y": 155,
          "width": "260px",
          "height": "40px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "input": "volumeCard.textContent = 'Volume: ' + event.target.value + '%';"
          }
        },
        {
          "id": "cbc4274e-2cd6-4e2f-92a4-41851b330eee",
          "kind": "valuecard",
          "name": "volumeCard",
          "text": "Volume: 50%",
          "x": 24,
          "y": 210,
          "width": "260px",
          "height": "100px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "// volumeCard\n"
          },
          "value": ""
        },
        {
          "id": "eacd674f-0545-455b-a9c1-dc0521838fdb",
          "kind": "checkbox",
          "name": "notify1",
          "text": "Receber notificações",
          "x": 24,
          "y": 330,
          "width": "230px",
          "height": "40px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "change": "status1.textContent = event.target.checked ? 'Notificações ativadas' : 'Notificações desativadas';"
          }
        },
        {
          "id": "ca1e1a1f-fa45-4089-add1-0eb95f7d308e",
          "kind": "statuscard",
          "name": "status1",
          "text": "Configurações prontas",
          "x": 24,
          "y": 390,
          "width": "350px",
          "height": "90px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "// status1\n"
          },
          "value": ""
        }
      ]
    }
  ]
