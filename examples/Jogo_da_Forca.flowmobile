        {
          "id": "8b295c11-d87c-4154-837b-6f35beef9950",
          "kind": "button",
          "name": "forcaA",
          "text": "A",
          "x": 20,
          "y": 262,
          "width": "47px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "var $=function(i){return document.getElementById(i)};if(!window.ffForca){var F=window.ffForca={W:{\"Frutas\": [\"MORANGO\", \"ABACAXI\", \"LARANJA\", \"MELANCIA\", \"BANANA\"], \"Animais\": [\"ELEFANTE\", \"GIRAFA\", \"TARTARUGA\", \"GOLFINHO\", \"CAVALO\"], \"Tecnologia\": [\"TECLADO\", \"NAVEGADOR\", \"PROGRAMA\", \"INTERNET\", \"SERVIDOR\"]},word:'',cat:'',hit:{},miss:0,over:true,max:6,art:['😀','😐','😟','😨','😰','😱','💀']};F.draw=function(){$('forcaFace').style.fontSize='48px';$('forcaWord').style.cssText+=';font-size:30px;font-weight:700;letter-spacing:2px';var w=F.word.split('').map(function(c){return F.hit[c]||F.over&&F.miss>=F.max?c:'_'}).join(' ');$('forcaWord').textContent=w||'Clique em Novo jogo';$('forcaInfo').textContent=F.word?('Dica: '+F.cat+' · Erros: '+F.miss+'/'+F.max):'';$('forcaFace').textContent=F.art[F.miss];'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').forEach(function(l){var b=$('forca'+l);if(b){b.disabled=F.over||!!F.hit[l]||!!F.tried[l];b.style.background=F.hit[l]?'#bbf7d0':F.tried[l]?'#fecaca':'#ffffff'}})};F.tried={};F.start=function(){var cats=Object.keys(F.W);F.cat=cats[Math.floor(Math.random()*cats.length)];var l=F.W[F.cat];F.word=l[Math.floor(Math.random()*l.length)];F.hit={};F.tried={};F.miss=0;F.over=false;$('forcaStatus').textContent='Escolha uma letra';F.draw()};F.guess=function(l){if(F.over||F.tried[l])return;F.tried[l]=true;if(F.word.indexOf(l)>=0){F.hit[l]=true;if(F.word.split('').every(function(c){return F.hit[c]})){F.over=true;$('forcaStatus').textContent='Você venceu! 🎉'}else $('forcaStatus').textContent='Boa!'}else{F.miss++;if(F.miss>=F.max){F.over=true;$('forcaStatus').textContent='Fim de jogo! A palavra era '+F.word}else $('forcaStatus').textContent='Letra errada'}F.draw()};F.draw()}window.ffForca.guess('A');"
          }
        },
