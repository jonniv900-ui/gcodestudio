            "click": "const p='Pedra',opts=['Pedra','Papel','Tesoura'],cpu=opts[Math.floor(Math.random()*3)];let r=p===cpu?'Empate':(p==='Pedra'&&cpu==='Tesoura'||p==='Papel'&&cpu==='Pedra'||p==='Tesoura'&&cpu==='Papel')?'Você venceu!':'IA venceu!';document.getElementById('rpsStatus').textContent='Você: '+p+' | IA: '+cpu+' — '+r;"
          }
        },
