          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "change": "var $=function(i){return document.getElementById(i)};if(!window.ffConv){var C=window.ffConv={U:{'Comprimento':{'Metro':1,'Quilômetro':1000,'Centímetro':0.01,'Milha':1609.344,'Pé':0.3048,'Polegada':0.0254},'Massa':{'Quilograma':1,'Grama':0.001,'Libra':0.45359237,'Onça':0.028349523125,'Tonelada':1000},'Volume':{'Litro':1,'Mililitro':0.001,'Galão (US)':3.785411784,'Metro cúbico':1000,'Copo (240 ml)':0.24},'Temperatura':{'Celsius':1,'Fahrenheit':1,'Kelvin':1}}};C.fill=function(sel,names,keep){sel.innerHTML='';names.forEach(function(n){var o=document.createElement('option');o.value=o.textContent=n;sel.appendChild(o)});if(keep&&names.indexOf(keep)>=0)sel.value=keep};C.cat=function(){var names=Object.keys(C.U[$('convCat').value]);C.fill($('convFrom'),names);C.fill($('convTo'),names);$('convFrom').selectedIndex=0;$('convTo').selectedIndex=Math.min(1,names.length-1)};C.temp=function(v,a,b){var c=a==='Celsius'?v:a==='Fahrenheit'?(v-32)*5/9:v-273.15;return b==='Celsius'?c:b==='Fahrenheit'?c*9/5+32:c+273.15};C.run=function(){var raw=$('convValue').value.replace(',','.').trim(),v=Number(raw),r0=$('convResult'),r=r0.querySelector('small')||r0;if(raw===''||!isFinite(v)){r.textContent='Digite um número';return}var cat=$('convCat').value,a=$('convFrom').value,b=$('convTo').value,out;if(cat==='Temperatura')out=C.temp(v,a,b);else out=v*C.U[cat][a]/C.U[cat][b];var s=Number(out.toPrecision(10)).toLocaleString('pt-BR',{maximumFractionDigits:6});r.textContent=raw.replace('.',',')+' '+a+' = '+s+' '+b};C.cat()}window.ffConv.cat();window.ffConv.run();"
          },
          "items": [
            "Comprimento",
            "Massa",
            "Volume",
            "Temperatura"
          ]
