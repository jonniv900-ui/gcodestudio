        {
          "id": "5bfb3704-df75-4031-aa43-ed7a45017a59",
          "kind": "input",
          "name": "todoInput",
          "text": "Nova tarefa...",
          "x": 20,
          "y": 132,
          "width": "252px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "keydown": "var $=function(i){return document.getElementById(i)};if(!window.ffTodo){var T=window.ffTodo={items:[],filter:'Todas',id:0};try{T.items=JSON.parse(localStorage.getItem('ffTodoV1')||'[]')}catch(e){}T.id=T.items.reduce(function(m,t){return Math.max(m,t.id)},0);T.save=function(){try{localStorage.setItem('ffTodoV1',JSON.stringify(T.items))}catch(e){}};T.render=function(){var box=$('todoList');box.innerHTML='';var vis=T.items.filter(function(t){return T.filter==='Todas'||(T.filter==='Pendentes'?!t.done:t.done)});vis.forEach(function(t){var r=document.createElement('div');r.className='todo-row';r.dataset.id=t.id;r.style.cssText='display:flex;align-items:center;gap:8px;padding:6px 4px;border-bottom:1px solid #e5e7eb';var c=document.createElement('input');c.type='checkbox';c.checked=t.done;c.setAttribute('aria-label','Concluir');c.onchange=function(){t.done=c.checked;T.save();T.render()};var s=document.createElement('span');s.textContent=t.text;s.style.cssText='flex:1;'+(t.done?'text-decoration:line-through;color:#9ca3af':'');var x=document.createElement('button');x.textContent='✕';x.title='Remover';x.className='todo-del';x.style.cssText='border:0;background:transparent;color:#ef4444;cursor:pointer;font-size:16px';x.onclick=function(){T.items=T.items.filter(function(i){return i!==t});T.save();T.render()};r.append(c,s,x);box.appendChild(r)});if(!vis.length){var e=document.createElement('div');e.textContent=T.items.length?'Nada neste filtro.':'Nenhuma tarefa. Adicione a primeira!';e.style.cssText='padding:14px;color:#9ca3af;text-align:center';box.appendChild(e)}var left=T.items.filter(function(t){return!t.done}).length;$('todoCount').textContent=left===1?'1 tarefa pendente':left+' tarefas pendentes'};T.add=function(){var f=$('todoInput'),v=f.value.trim();if(!v){$('todoCount').textContent='Digite uma tarefa';return}T.items.push({id:++T.id,text:v,done:false});f.value='';T.save();T.render();f.focus()};T.render()}if(event.key==='Enter'){window.ffTodo.add()}"
          }
        },
